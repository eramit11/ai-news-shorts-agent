from __future__ import annotations

import asyncio
import subprocess
from pathlib import Path

import edge_tts

from PIL import (
    Image,
    ImageDraw,
    ImageFont,
    ImageFilter,
)


# ============================================================
# FONT CONFIGURATION
# ============================================================

FONT_DIRS = [
    Path("/usr/share/fonts/truetype/dejavu"),
    Path("/usr/share/fonts/truetype/liberation2"),
]


def find_font(
    names: list[str],
    size: int,
):
    for directory in FONT_DIRS:
        for name in names:
            path = directory / name

            if path.exists():
                return ImageFont.truetype(
                    str(path),
                    size,
                )

    return ImageFont.load_default()


FONT_BOLD = [
    "DejaVuSans-Bold.ttf",
    "LiberationSans-Bold.ttf",
]

FONT_REGULAR = [
    "DejaVuSans.ttf",
    "LiberationSans-Regular.ttf",
]


